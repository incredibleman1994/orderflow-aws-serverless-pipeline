{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyOurBucketToSendEvents",
      "Effect": "Allow",
      "Principal": { "Service": "s3.amazonaws.com" },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:REPLACE_REGION:REPLACE_ACCOUNT_ID:file-events-queue",
      "Condition": {
        "ArnLike": { "aws:SourceArn": "arn:aws:s3:::REPLACE_BUCKET" },
        "StringEquals": { "aws:SourceAccount": "REPLACE_ACCOUNT_ID" }
      }
    }
  ]
}
